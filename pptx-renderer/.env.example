# Public URL of this Hugging Face Space.
PUBLIC_BASE_URL=https://YOUR-SPACE.hf.space

# Optional external ONLYOFFICE Document Server URL.
# Leave empty to use LibreOffice fallback rendering only.
ONLYOFFICE_URL=

# Maximum uploaded PPTX size.
MAX_UPLOAD_MB=100

# Optional persistent data location.
DATA_ROOT=/data
